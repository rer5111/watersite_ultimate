# ==============================================================================
# Waltercraft Microservices Environment Configuration
# Architecture Rule: Each domain microservice owns its own database
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Player Service Database (player-db)
# ------------------------------------------------------------------------------
PLAYER_DB_HOST=player-db
PLAYER_DB_PORT=5432
PLAYER_DB_NAME=player_db
PLAYER_DB_USER=postgres
PLAYER_DB_PASSWORD=your_secure_player_db_password_here

# ------------------------------------------------------------------------------
# 2. Domain Service Databases (per AGENTS.md bounded contexts)
# ------------------------------------------------------------------------------
DONATION_DB_HOST=donation-db
DONATION_DB_PORT=5432
DONATION_DB_NAME=donation_db
DONATION_DB_USER=donation_user
DONATION_DB_PASSWORD=replace_with_a_unique_secure_donation_db_password

APPLICATION_DB_HOST=application-db
APPLICATION_DB_PORT=5432
APPLICATION_DB_NAME=application_db
APPLICATION_DB_USER=application_user
APPLICATION_DB_PASSWORD=replace_with_a_unique_secure_application_db_password

PAYMENT_DB_HOST=payment-db
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=replace_with_a_unique_secure_payment_db_password

NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=replace_with_a_unique_secure_notification_db_password

SEASON_DB_HOST=season-db
SEASON_DB_PORT=5432
SEASON_DB_NAME=season_db
SEASON_DB_USER=season_user
SEASON_DB_PASSWORD=replace_with_a_unique_secure_season_db_password

EVENT_DB_HOST=event-db
EVENT_DB_PORT=5432
EVENT_DB_NAME=event_db
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=replace_with_a_unique_secure_event_db_password

# ------------------------------------------------------------------------------
# 3. Player Service Application Credentials
# ------------------------------------------------------------------------------
PLAYER_SERVICE_USER=admin_user
PLAYER_SERVICE_PASSWORD=change_this_player_service_password
ADMIN_INITIAL_PASSWORD_HASH=*LOCKED*
AUTH_SERVICE_SHARED_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
NOTIFICATION_SERVICE_SHARED_SECRET=replace_with_a_different_random_secret_at_least_32_chars
VERIFICATION_CODE_PEPPER=replace_with_a_separate_random_pepper_at_least_32_chars

# ------------------------------------------------------------------------------
# 4. Auth Service JWT signing
# In production, provide a persistent Base64-encoded RSA PKCS#8 DER private key
# and set AUTH_JWT_ALLOW_EPHEMERAL_KEY=false. Never commit the key.
# ------------------------------------------------------------------------------
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_ALLOW_EPHEMERAL_KEY=true
AUTH_JWT_ISSUER=https://auth.waltercraft.ru
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D

# ------------------------------------------------------------------------------
# 4.1. Microsoft OAuth2 (Azure App Registration)
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
MICROSOFT_SCOPES=XboxLive.signin offline_access

# ------------------------------------------------------------------------------
# 5. API Gateway & Security
# ------------------------------------------------------------------------------
GATEWAY_JWT_ENABLED=true
JWT_JWK_SET_URI=http://auth-service:8090/.well-known/jwks.json
FRONTEND_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# 7. Discord chat bridge (enable after adding the bot to the server/channel)
# ------------------------------------------------------------------------------
DISCORD_BOT_ENABLED=false
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MINECRAFT_BOT_USER_ID=1042883408596062298

# ------------------------------------------------------------------------------
# 6. External Skin Provider
# ------------------------------------------------------------------------------
SKIN_PROVIDER_USER_AGENT=WaltercraftSkinService/1.0 (+https://waltercraft.ru; admin@waltercraft.ru)

# ------------------------------------------------------------------------------
# 8. Notification Service Email (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Waltercraft <noreply@waltercraft.ru>"

# ------------------------------------------------------------------------------
# 9. YooMoney P2P Donations (Личный кошелек физлица)
# ------------------------------------------------------------------------------
YOOMONEY_WALLET=410011234567890
YOOMONEY_NOTIFICATION_SECRET=your_yoomoney_secret_word_here
YOOMONEY_SUCCESS_URL=http://localhost:5173/donations/result
