# ==============================================================================
# Waltercraft Microservices Environment Configuration
# Architecture Rule: Each domain microservice owns its own database
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Player Service Database (player-db)
# ------------------------------------------------------------------------------
PLAYER_DB_HOST=player-db
PLAYER_DB_PORT=5432
PLAYER_DB_NAME=player_db
PLAYER_DB_USER=postgres
PLAYER_DB_PASSWORD=your_secure_player_db_password_here

# ------------------------------------------------------------------------------
# 2. Future Microservice Databases (per AGENTS.md bounded contexts)
# ------------------------------------------------------------------------------
# DONATION_DB_HOST=donation-db
# DONATION_DB_PORT=5432
# DONATION_DB_NAME=donation_db
# DONATION_DB_USER=donation_user
# DONATION_DB_PASSWORD=change_this_donation_db_password

# APPLICATION_DB_HOST=application-db
# APPLICATION_DB_PORT=5432
# APPLICATION_DB_NAME=application_db
# APPLICATION_DB_USER=application_user
# APPLICATION_DB_PASSWORD=change_this_application_db_password

# PAYMENT_DB_HOST=payment-db
# PAYMENT_DB_PORT=5432
# PAYMENT_DB_NAME=payment_db
# PAYMENT_DB_USER=payment_user
# PAYMENT_DB_PASSWORD=change_this_payment_db_password

# ------------------------------------------------------------------------------
# 3. Player Service Application Credentials
# ------------------------------------------------------------------------------
PLAYER_SERVICE_USER=admin_user
PLAYER_SERVICE_PASSWORD=change_this_player_service_password
ADMIN_INITIAL_PASSWORD_HASH=*LOCKED*
AUTH_SERVICE_SHARED_SECRET=

# ------------------------------------------------------------------------------
# 4. Auth Service JWT signing
# In production, provide a persistent Base64-encoded RSA PKCS#8 DER private key
# and set AUTH_JWT_ALLOW_EPHEMERAL_KEY=false. Never commit the key.
# ------------------------------------------------------------------------------
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_ALLOW_EPHEMERAL_KEY=true
AUTH_JWT_ISSUER=https://auth.waltercraft.ru
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D

# ------------------------------------------------------------------------------
# 5. API Gateway & Security
# ------------------------------------------------------------------------------
GATEWAY_JWT_ENABLED=true
JWT_JWK_SET_URI=http://auth-service:8090/.well-known/jwks.json
FRONTEND_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# 6. External Skin Provider
# ------------------------------------------------------------------------------
SKIN_PROVIDER_USER_AGENT=WaltercraftSkinService/1.0 (+https://waltercraft.ru; admin@waltercraft.ru)
